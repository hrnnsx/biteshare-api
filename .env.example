PORT=8080
APP_ENV=local

# Use a random value with at least 32 characters in real environments.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ISSUER=biteshare-api
JWT_ACCESS_TOKEN_TTL=24h

# Used only by: go run ./cmd/seed-admin
ADMIN_1_NAME=Admin One
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD=replace-with-a-strong-password
ADMIN_2_NAME=Admin Two
ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD=replace-with-a-strong-password
ADMIN_3_NAME=Admin Three
ADMIN_3_EMAIL=admin3@example.com
ADMIN_3_PASSWORD=replace-with-a-strong-password

# Email Service (Resend)
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Database Configuration (Supabase PostgreSQL)
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=postgres
BLUEPRINT_DB_USERNAME=postgres
BLUEPRINT_DB_PASSWORD=password
BLUEPRINT_DB_SCHEMA=public
BLUEPRINT_DB_SSLMODE=require