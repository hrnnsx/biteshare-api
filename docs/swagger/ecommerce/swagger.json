                ],
                "summary": "Checkout products",
                "parameters": [
                    {
                        "description": "Buyer and order information",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CheckoutRequest"
